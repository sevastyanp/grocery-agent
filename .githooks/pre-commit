#!/usr/bin/env bash

# Nothing to check when the commit touches no Kotlin sources
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.kts?$'; then
  exit 0
fi

echo "Running detekt check..."
OUTPUT=$(mktemp)
./gradlew -Pprecommit=true detekt --console=plain > "$OUTPUT" 2>&1
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  cat "$OUTPUT"
  rm -f "$OUTPUT"
  echo "***********************************************"
  echo "                 detekt failed                 "
  echo " Please fix the above issues before committing "
  echo "***********************************************"
  exit $EXIT_CODE
fi

rm -f "$OUTPUT"
